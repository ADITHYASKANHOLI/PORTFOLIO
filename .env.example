# Admin Portal Key (Server-side / Vercel Environment Variable)
# Configure ADMIN_KEY in your Vercel Project Settings -> Environment Variables.
# For local dev testing with Vite, you can optionally provide:
# ADMIN_KEY=your_secret_admin_key_here
# Note: Never prefix with VITE_ or expose this key to client bundles!

# Supabase Configuration
# Replace these with your actual Supabase project URL and Anon (Publishable) Key
# from your Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Note:
# 1. Do NOT put your service_role secret key in this file or any frontend code!
# 2. When Supabase keys are not set, the application operates in resilient demo/offline mode
#    with genuine seed data so you can inspect the design and test interactions immediately.

